# ─────────────────────────────────────────────────────────────────────────────
# Trade website template: environment variables
#
# Local development: copy to .env.local. Every key is optional locally (the site falls
# back to starter content, a local leads file and an email outbox file).
#
# Production (Vercel → Project → Settings → Environment Variables, then redeploy):
# keys marked [REQUIRED IN PRODUCTION] are checked at build and at server start.
# If any are missing or unsafe, the deployment stops and lists them (lib/env-check.ts).
#
# Never give a secret the NEXT_PUBLIC_ prefix: NEXT_PUBLIC_ values are sent to every browser.
# The values below are neutral examples, not real settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client ──
# Which folder in /clients to build. Leave unset to use the committed default (demo-builder).
CLIENT=demo-builder

# ── Site address ──
# [REQUIRED IN PRODUCTION] The public address, https:// and no trailing slash. Used for canonical
# links, the sitemap and links in emails. Until it's a real domain, search engines are kept out.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Lead storage: Supabase ──
# [REQUIRED IN PRODUCTION] Project URL (Supabase → Project Settings → API).
SUPABASE_URL=https://your-project-ref.supabase.co
# [REQUIRED IN PRODUCTION] Secret service-role key. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email: Resend ──
# [REQUIRED IN PRODUCTION] API key from the Resend account that owns the verified sending domain.
RESEND_API_KEY=
# [REQUIRED IN PRODUCTION] Sender on a domain verified in Resend (not onboarding@resend.dev).
EMAIL_FROM="Business Name <quotes@example.com>"
# [REQUIRED IN PRODUCTION] Inbox that receives a summary of every new lead.
LEAD_NOTIFY_EMAIL=owner@example.com

# ── Leads dashboard (/admin) ──
# [REQUIRED IN PRODUCTION] 12+ characters, not a common password or the business name.
ADMIN_PASSWORD=
# [REQUIRED IN PRODUCTION] 32+ random characters that sign admin logins, e.g. `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# ── Data retention (privacy policy) ──
# [REQUIRED IN PRODUCTION] 32+ random characters. Vercel sends it to the daily /api/cron/retention job.
CRON_SECRET=
# Optional: 1 = the daily job deletes enquiries past the privacy-policy retention periods.
# Leave blank to see them in /admin → Data clean-up and delete them by hand.
RETENTION_AUTO_DELETE=

# ── Content: Sanity (editing at /studio) ──
# Project ID and dataset are public identifiers (the NEXT_PUBLIC_ warning in Vercel is expected).
# Without them the site shows the client's built-in starter content and /studio is off.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: secret for the Sanity webhook → /api/revalidate, so edits appear instantly.
SANITY_REVALIDATE_SECRET=
# Only needed once, locally, to run `npm run seed:sanity`. Delete the token afterwards.
SANITY_API_WRITE_TOKEN=
# Optional: false = read Sanity's live API instead of its CDN (debugging only).
SANITY_USE_CDN=

# ── Spam protection: Cloudflare Turnstile (recommended in production) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google tracking (see TRACKING.md) ──
# Set for PRODUCTION only. Empty = no cookie banner, no tracking, nothing loads.
# Scripts load only on the production deployment and only after the visitor accepts cookies.
# Recommended: just the Tag Manager container ID, with GA4 and Google Ads set up inside GTM.
NEXT_PUBLIC_GTM_ID=
# Only if you're NOT using Tag Manager (the site then loads gtag.js directly):
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
# Google Ads conversion label for "Quote request" (gtag.js mode only).
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# ── Local development and tests only (never set on Vercel) ──
# Where the local leads file, uploads and email outbox are written (default .data).
LOCAL_DATA_DIR=
# 1 = allow the local leads file, email outbox and a warning-only settings check in a local
# production build. Used by the automated tests. Refused on Vercel production.
ALLOW_TEST_FALLBACKS=
# 1 = switch off the per-visitor rate limit (automated tests only).
DISABLE_RATE_LIMIT=
# 1 = let the tracking loader inject Google scripts outside production (automated tests only;
# Google hosts are blocked in the tests).
TRACKING_LOAD_OUTSIDE_PRODUCTION=
# Set automatically, don't add them: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
# NEXT_PUBLIC_VERCEL_ENV (Vercel), NODE_ENV, NEXT_RUNTIME (Next.js), CI, PW_CHROMIUM_PATH (test runners).
